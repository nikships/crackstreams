<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/nikships/crackstreams"
        version="1.1.4" viewmodes="maximized">
    <feature name="http://tizen.org/feature/web.service"/>
    <tizen:application id="CrackTV001.Player" package="CrackTV001" required_version="10.0"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:allow-mixed-content>true</tizen:allow-mixed-content>
    <tizen:service id="CrackTV001.HLS">
        <tizen:content src="service/index.js"/>
        <tizen:name>Crackstreams HLS</tizen:name>
        <tizen:description>Resolves and relays HLS locally for the Crackstreams player</tizen:description>
    </tizen:service>
    <tizen:setting screen-orientation="landscape" context-menu="disable"
                   background-support="enable" encryption="disable"/>
    <access origin="http://127.0.0.1:48639"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>Crackstreams</name>
</widget>
