<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/nikships/crackstreams"
        version="1.0.0" viewmodes="maximized">
    <tizen:application id="CrackTV001.Player" package="CrackTV001" required_version="6.0"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable"
                   background-support="disable" encryption="disable"/>
    <access origin="__RELAY_ORIGIN__"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>Crackstreams</name>
</widget>
